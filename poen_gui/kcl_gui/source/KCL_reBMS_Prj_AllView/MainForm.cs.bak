            cbWarnningEnable2.Checked  = (byte.Parse(strWCellUnderVoltageEnable) == 1) ? true : false;
            cbWarnningEnable3.Checked  = (byte.Parse(strWPackOverVoltageEnable) == 1) ? true : false;
